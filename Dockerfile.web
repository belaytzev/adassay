FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/adassay-web ./cmd/adassay-web

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/adassay-web /adassay-web
EXPOSE 8080
ENTRYPOINT ["/adassay-web"]
